{
  "name": "vagejs",
  "version": "0.1.0",
  "description": "VAGE JS — an AI-native, static-first web framework (pre-release, unpublished).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "vage": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude tests/e2e.test.ts",
    "test:e2e": "npm run build && vitest run tests/e2e.test.ts"
  },
  "dependencies": {
    "cac": "^7.1.0",
    "marked": "^18.1.1",
    "node-html-parser": "^9.0.5",
    "vite": "^8.3.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
