{
  "name": "vagejs",
  "version": "0.1.0",
  "description": "AI-native, static-first web framework: Markdown sites with built-in SEO, llms.txt, audits, security and safe deploys.",
  "keywords": [
    "static-site-generator",
    "ssg",
    "markdown",
    "seo",
    "llms-txt",
    "ai-agents",
    "vite",
    "cli",
    "web-framework"
  ],
  "homepage": "https://vagejs.com",
  "author": "vagejs.com",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vage": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": "./dist/cli/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude tests/e2e.test.ts",
    "test:e2e": "npm run build && vitest run tests/e2e.test.ts",
    "guidelines:monitor": "npm run build && node scripts/guidelines-monitor.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "axe-core": "^4.14.0",
    "cac": "^7.1.0",
    "dompurify": "^3.4.17",
    "jsdom": "^28.1.0",
    "marked": "^18.1.1",
    "node-html-parser": "^9.0.5",
    "vite": "^8.3.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.6.5",
    "lighthouse": "^13.5.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "lighthouse": ">=13"
  },
  "peerDependenciesMeta": {
    "lighthouse": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agevenkat/vagejs.git"
  },
  "bugs": {
    "url": "https://github.com/agevenkat/vagejs/issues"
  }
}
