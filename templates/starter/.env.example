# Copy to .env (git-ignored) or export in your shell. Never commit real values.

# Public GA4 measurement ID; read in vage.config.ts via process.env.GA4_MEASUREMENT_ID
GA4_MEASUREMENT_ID=

# Google Cloud OAuth client (type "Desktop app") for `vage connect gsc|ga4`
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Your own Google Cloud API keys for `vage audit --url` (or save them with `vage connect pagespeed` / `vage connect crux`)
PAGESPEED_API_KEY=
CRUX_API_KEY=
