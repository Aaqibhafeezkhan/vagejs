  "rules": [
    {
      "id": "robots.ai-crawlers",
      "summary": "robots.txt tokens for AI crawlers, split into training vs search. Only documented robots.txt-honoring tokens; user-initiated fetchers excluded.",
      "behaviorChanging": true,
      "sources": [
        "openai-bots",
        "anthropic-crawlers",
        "google-crawlers"
      ],
      "implementedIn": [
        "src/discovery/crawlers.ts",
        "src/discovery/robots.ts"
      ],
      "data": {
        "crawlers": [
          {
            "token": "GPTBot",
            "provider": "OpenAI",
            "purpose": "training",
            "source": "openai-bots"
          },
          {
            "token": "OAI-SearchBot",
            "provider": "OpenAI",
            "purpose": "search",
            "source": "openai-bots"
          },
          {
            "token": "ClaudeBot",
            "provider": "Anthropic",
            "purpose": "training",
            "source": "anthropic-crawlers"
          },
          {
            "token": "Claude-SearchBot",
            "provider": "Anthropic",
            "purpose": "search",
            "source": "anthropic-crawlers"
          },
          {
            "token": "Google-Extended",
            "provider": "Google",
            "purpose": "training",
            "source": "google-crawlers"
          }
        ]
      }
    },
    {
      "id": "sitemap.limits",
      "summary": "Maximum URLs per sitemap file.",
      "behaviorChanging": true,
      "sources": [
        "google-sitemaps",
        "sitemaps-protocol"
      ],
      "implementedIn": [
        "src/discovery/sitemap.ts"
      ],
      "data": {
        "maxUrls": 50000
      }
    },
    {
      "id": "vitals.thresholds",
      "summary": "Core Web Vitals good / poor thresholds at the 75th percentile.",
      "behaviorChanging": true,
      "sources": [
        "web-vitals"
      ],
      "implementedIn": [
        "src/audit/vitals.ts"
      ],
      "data": {
        "lcp": {
          "good": 2500,
          "poor": 4000
        },
        "inp": {
          "good": 200,
          "poor": 500
        },
        "cls": {
          "good": 0.1,
          "poor": 0.25
        }
      }
    },
    {
      "id": "ga4.naming",
      "summary": "GA4 event and parameter naming rules and length limits.",
      "behaviorChanging": true,
      "sources": [
        "ga4-event-naming",
        "ga4-limits"
      ],
      "implementedIn": [
        "src/core/config.ts"
      ],
      "data": {
        "maxNameLength": 40,
        "reservedParamPrefixes": [
          "_",
          "firebase_",
          "ga_",
          "google_",
          "gtag."
        ]
      }
    },
    {
      "id": "consent.default-order",
      "summary": "Consent defaults are set before any measurement command; four consent types.",
      "behaviorChanging": true,
      "sources": [
        "google-consent"
      ],
      "implementedIn": [
        "src/integrations/tags.ts"
      ],
      "data": {
        "types": [
          "ad_storage",
          "ad_user_data",
          "ad_personalization",
          "analytics_storage"
        ]
      }
    },
    {
      "id": "seo.canonical-and-structured-data",
      "summary": "Absolute canonical URLs; structured data must match visible content; Article recommended properties.",
      "behaviorChanging": false,
      "sources": [
        "google-canonical",
        "google-sd-policies",
        "google-article",
        "schema-org"
      ],
      "implementedIn": [
        "src/seo/head.ts",
        "src/checks/check.ts"
      ]
    },
    {
      "id": "llms-txt.format",
      "summary": "llms.txt layout (H1 title, blockquote summary, link sections). An emerging convention.",
      "behaviorChanging": false,
      "sources": [
        "llms-txt"
      ],
      "implementedIn": [
        "src/discovery/llms.ts"
      ]
    },
    {
      "id": "audit.field-data-source",
      "summary": "Field data from the CrUX API (PSI field data is planned for discontinuation); lab data from PageSpeed Insights.",
      "behaviorChanging": false,
      "sources": [
        "psi-api",
        "crux-api"
      ],
      "implementedIn": [
        "src/audit/remote.ts"
      ]
    },
    {
      "id": "accessibility.baseline",
      "summary": "Automated accessibility rules (axe-core) as a baseline, not WCAG conformance.",
      "behaviorChanging": false,
      "sources": [
        "w3c-wai"
      ],
      "implementedIn": [
        "src/audit/a11y.ts",
        "src/checks/check.ts"
      ]
    },
    {
      "id": "google-apis.reporting",
      "summary": "Desktop OAuth (loopback + PKCE) with read-only scopes; Search Analytics and GA4 runReport request shapes.",
      "behaviorChanging": false,
      "sources": [
        "google-oauth-native",
        "gsc-searchanalytics",
        "ga4-runreport"
      ],
      "implementedIn": [
        "src/integrations/google-auth.ts",
        "src/integrations/search-console.ts",
        "src/integrations/ga4-data.ts"
      ]
    },
    {
      "id": "hosting.github-pages",
      "summary": "GitHub Pages via Actions: permissions, environment, artifact; CNAME not required.",
      "behaviorChanging": true,
      "sources": [
        "gh-pages-workflows",
        "gh-pages-custom-domain"
      ],
      "implementedIn": [
        "src/deploy/github-pages.ts"
      ]
    },
    {
      "id": "search.general",
      "summary": "General search guidance tracked for future rules.",
      "behaviorChanging": false,
      "sources": [
        "google-search-essentials",
        "google-robots",
        "bing-guidelines"
      ],
      "implementedIn": []
    },
    {
      "id": "indexnow.protocol",
      "summary": "IndexNow submission: shared endpoint, up to 10,000 URLs per request, key 8-128 chars served at /<key>.txt; 200/202 accepted.",
      "behaviorChanging": true,
      "sources": [
        "indexnow",
        "indexnow-faq"
      ],
      "implementedIn": [
        "src/integrations/indexnow.ts"
      ],
      "data": {
        "endpoint": "https://api.indexnow.org/indexnow",
        "maxUrls": 10000,
        "keyPattern": "^[A-Za-z0-9-]{8,128}$"
      }
    },
    {
      "id": "clarity.consent",
      "summary": "Clarity consent via consentv2 with ad_Storage / analytics_Storage.",
      "behaviorChanging": true,
      "sources": [
        "clarity-consent"
      ],
      "implementedIn": [
        "src/integrations/tags.ts"
      ]
    },
    {
      "id": "plausible.events",
      "summary": "Plausible custom events: plausible(name, { props }).",
      "behaviorChanging": false,
      "sources": [
        "plausible-events"
      ],
      "implementedIn": [
        "src/integrations/tags.ts"
      ]
    },
    {
      "id": "cloudflare.redirects",
      "summary": "_redirects format 'source destination status', up to 2,000 static rules.",
      "behaviorChanging": true,
      "sources": [
        "cloudflare-redirects"
      ],
      "implementedIn": [
        "src/deploy/cloudflare-pages.ts"
      ],
      "data": {
        "maxStaticRules": 2000
      }
    },
    {
      "id": "csp.providers",
      "summary": "CSP sources required by analytics providers (GA4 without Ads features, Tag Manager, Clarity).",
      "behaviorChanging": true,
      "sources": [
        "google-csp",
        "clarity-csp"
      ],
      "implementedIn": [
        "src/deploy/headers.ts"
      ],
      "data": {
        "google": {
          "script-src": [
            "https://www.googletagmanager.com"
          ],
          "connect-src": [
            "https://www.googletagmanager.com",
            "https://*.google-analytics.com",
            "https://*.google.com"
          ],
          "img-src": [
            "https://www.googletagmanager.com",
            "https://*.google-analytics.com"
          ],
          "frame-src": [
            "https://www.googletagmanager.com"
          ]
        },
        "clarity": {
          "script-src": [
            "https://*.clarity.ms",
            "https://c.bing.com"
          ],
          "connect-src": [
            "https://*.clarity.ms",
            "https://c.bing.com"
          ],
          "img-src": [
            "https://*.clarity.ms",
            "https://c.bing.com"
          ]
        }
      }
    },
    {
      "id": "cloudflare.headers",
      "summary": "_headers format; up to 100 rules, 2,000 characters per line.",
      "behaviorChanging": true,
      "sources": [
        "cloudflare-headers"
      ],
      "implementedIn": [
        "src/deploy/headers.ts"
      ],
      "data": {
        "maxLineLength": 2000
      }
    }
  ],
